---
import DevLayout from '../layouts/DevLayout.astro';

const packages = [
  { name: '@autional-cn/core', desc: '令牌管理、API 客户端、认证流程', install: 'npm install @autional-cn/core' },
  { name: '@autional-cn/react', desc: 'React SDK — AuthProvider、useAuth、RequireAuth', install: 'npm install @autional-cn/react @autional-cn/core' },
  { name: '@autional-cn/vue', desc: 'Vue 3 SDK — 插件、组合式函数、路由守卫', install: 'npm install @autional-cn/vue @autional-cn/core' },
  { name: '@autional-cn/next', desc: 'Next.js App Router SDK', install: 'npm install @autional-cn/next @autional-cn/core' },
  { name: '@autional-cn/node', desc: 'Node.js 服务端中间件', install: 'npm install @autional-cn/node' },
  { name: '@autional-cn/miniapp', desc: '微信小程序适配器', install: 'npm install @autional-cn/miniapp @autional-cn/core' },
  { name: '@autional-cn/react-native', desc: 'React Native SDK', install: 'npm install @autional-cn/react-native @autional-cn/core' },
  { name: '@autional-cn/plugin-mfa', desc: 'MFA 配置流程', install: 'npm install @autional-cn/plugin-mfa' },
  { name: '@autional-cn/plugin-passkey', desc: '通行密钥（Passkey）注册与断言', install: 'npm install @autional-cn/plugin-passkey' },
  { name: '@autional-cn/plugin-tenant', desc: '多租户组织管理', install: 'npm install @autional-cn/plugin-tenant' },
];
const apis = [
  'api-identity','api-mfa','api-oauth','api-session','api-profile','api-tenant','api-rbac',
  'api-billing','api-audit','api-compliance','api-wallet','api-point','api-pay','api-storage',
  'api-notification','api-communication','api-secret','api-status','api-saml','api-verification',
];

const highlights = [
  { label: '软件包', value: '31' },
  { label: 'API 客户端', value: '20+' },
  { label: '微服务', value: '24' },
];
---
<DevLayout title="SDK — Autional 开发者" description="Autional SDK — 31 个软件包、20+ 个面向 React、Vue、Next.js、Node.js 的 API 客户端。用类型安全、可直接上生产的库更快交付身份能力。">
  <section class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <span class="brand-kicker">开发者平台</span>
      {/* 此前是 leading-[var(--line-height-display-xl)] sm:leading-[var(--line-height-display-xl)] tracking-[var(--letter-spacing-display-xl)] —— 全部是站点自己发明的字距/行高。
    -0.06em 在 48px 的中文标题上等于每字收紧 2.88px（-6%），中文字身带边距，
    收紧到这个程度会明显挤在一起；这正是 U66 第③项说的「display 字距对 CJK 过紧」
    ——设计系统里早已修到 -0.02em，但**站点里还留着旧值**（上一轮我只查了 ui/ 仓，
    没查站点，所以漏了）。改为消费设计系统的排版令牌。 */}
<h1 class="mt-6 max-w-3xl text-5xl font-extrabold leading-[var(--line-height-display-xl)] sm:leading-[var(--line-height-display-xl)] tracking-[var(--letter-spacing-display-xl)] text-primary-900 sm:text-6xl">
        用生产级 SDK 与 API 客户端，更快交付身份能力。
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-600">
        Autional 为你的团队提供统一的软件包体系，覆盖认证、MFA、租户、通行密钥（Passkey）、会话，以及策略密集的企业级流程，无需再拼接多个厂商的方案。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/quickstart" class="brand-button-primary">3 步开始</a>
        <a href="/api" class="brand-button-secondary">浏览 API 参考</a>
      </div>
      <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-3">
        {highlights.map((item) => (
          <div class="brand-card px-5 py-5">
            <div class="text-2xl font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-800">{item.value}</div>
            <div class="mt-2 text-sm text-neutral-500">{item.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="developer-panel brand-grid relative overflow-hidden px-6 py-7">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-sky-300/10 blur-3xl"></div>
      <div class="relative flex items-center justify-between text-xs uppercase tracking-[0.28em] text-slate-400">
        <span>快速安装</span>
        <span>React / Vue / Next</span>
      </div>
      <pre class="developer-code mt-5">
<span class="text-slate-500">$</span> <span class="text-amber-300">npm</span> <span class="text-slate-100">install</span> <span class="text-sky-300">@autional-cn/react</span> <span class="text-sky-300">@autional-cn/core</span>

<span class="text-violet-300">import</span> <span class="text-slate-100">&#123; AuthProvider &#125;</span> <span class="text-violet-300">from</span> <span class="text-emerald-300">'@autional-cn/react'</span>;

<span class="text-violet-300">export function</span> <span class="text-amber-300">App</span><span class="text-slate-200">()</span> <span class="text-slate-200">&#123;</span>
  <span class="text-violet-300">return</span> <span class="text-slate-200">(</span>
    <span class="text-sky-300">&lt;AuthProvider</span> <span class="text-amber-200">tenant</span><span class="text-slate-200">=</span><span class="text-emerald-300">"demo"</span> <span class="text-sky-300">/&gt;</span>
  <span class="text-slate-200">)</span>;
<span class="text-slate-200">&#125;</span>
      </pre>
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="developer-chip">企业级 SSO</span>
        <span class="developer-chip">通行密钥（Passkey）</span>
        <span class="developer-chip">RBAC</span>
        <span class="developer-chip">租户隔离</span>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="flex items-end justify-between gap-4">
      <div>
        <span class="brand-kicker">框架 SDK</span>
        <h2 class="mt-4 text-3xl font-bold tracking-[var(--letter-spacing-display-lg)] text-primary-900">选择与你的运行时匹配的软件包。</h2>
      </div>
      <a href="/migration" class="hidden text-sm font-semibold text-primary-700 md:inline-flex">查看迁移指南</a>
    </div>
    <div class="mt-8 grid gap-4">
      {packages.map((p) => (
        <div class="brand-card flex flex-col gap-4 px-6 py-5 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <code class="text-sm font-semibold text-primary-700">{p.name}</code>
            <p class="mt-2 text-sm leading-7 text-neutral-600">{p.desc}</p>
          </div>
          <code class="inline-flex max-w-full overflow-x-auto rounded-2xl bg-slate-950 px-4 py-3 text-xs leading-6 text-slate-100 lg:max-w-[28rem]">{p.install}</code>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section grid gap-10 lg:grid-cols-[0.78fr_1.22fr]">
    <div class="brand-card px-6 py-7">
      <span class="brand-kicker">使用方式</span>
      <h2 class="mt-4 text-3xl font-bold tracking-[var(--letter-spacing-display-lg)] text-primary-900">一套软件包体系，多种部署路径。</h2>
      <p class="mt-4 text-sm leading-7 text-neutral-600">
        安装框架包即可完成 UI 集成；需要更精细的控制时，搭配自动生成的 API 客户端；从现有认证服务商迁移时，可随时查阅迁移指南。
      </p>
      <div class="mt-6 space-y-3 text-sm text-neutral-600">
        <div class="rounded-2xl border border-primary-100 bg-primary-50/80 px-4 py-3">
          <strong class="text-primary-800">快速上手：</strong>添加一个软件包并包裹你的应用。
        </div>
        <div class="rounded-2xl border border-sky-100 bg-sky-50/80 px-4 py-3">
          <strong class="text-primary-800">深度集成：</strong>调用生成的客户端与网关文档。
        </div>
        <div class="rounded-2xl border border-amber-100 bg-amber-50/80 px-4 py-3">
          <strong class="text-primary-800">企业级落地：</strong>使用迁移手册与租户感知的配置。
        </div>
      </div>
    </div>

    <div class="brand-card px-6 py-7">
      <div class="flex items-center justify-between gap-4">
        <div>
          <span class="brand-kicker">生成的客户端</span>
          <h2 class="mt-4 text-3xl font-bold tracking-[var(--letter-spacing-display-lg)] text-primary-900">让每个服务都进入同一套开发者工作流。</h2>
        </div>
        <span class="hidden rounded-full bg-primary-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-primary-700 md:inline-flex">OpenAPI 已同步</span>
      </div>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        {apis.map((a) => (
          <div class="rounded-2xl border border-primary-100/80 bg-white px-4 py-4 shadow-soft">
            <code class="text-xs text-primary-700">@autional-cn/{a}</code>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-16 brand-shell px-6 py-10 text-center sm:px-10">
    <span class="brand-kicker">准备交付</span>
    <h2 class="mt-5 text-3xl font-bold tracking-[var(--letter-spacing-display-lg)] text-primary-900 sm:text-4xl">一次安装，让认证在应用、API 与租户边界之间保持一致。</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-neutral-600">
      从框架 SDK 开始；需要服务级控制时，改用生成的客户端；企业级切换时，可随时查阅迁移指南。
    </p>
    <pre class="developer-code mx-auto mt-6 max-w-xl text-left"><span class="text-slate-500">$</span> <span class="text-amber-300">npm</span> <span class="text-slate-100">install</span> <span class="text-sky-300">@autional-cn/react</span> <span class="text-sky-300">@autional-cn/core</span></pre>
  </section>
</DevLayout>
