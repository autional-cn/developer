---
import DevLayout from '../layouts/DevLayout.astro';

const endpoints = [
  ['网关文档', 'https://reference.autional.cn/', '由网关提供的交互式 OpenAPI 界面。'],
  ['网关规范', 'https://reference.autional.cn/openapi.json', '供客户端工具使用与契约检查的聚合 JSON 规范。'],
  ['原始规范', 'https://reference.autional.cn/', '覆盖全部 24 个微服务的交互式 OpenAPI 规范浏览器。'],
];
---
<DevLayout title="API 参考 — Autional 开发者" description="面向开发者的 Autional API 参考 — 一个开发者入口背后汇聚 1,400+ REST 端点。通过网关提供交互式 Swagger 文档。">
  <section class="text-center">
    <span class="brand-kicker">API 概览</span>
    <h1 class="mt-6 text-5xl font-extrabold tracking-[-0.06em] text-primary-900 sm:text-6xl">一个开发者入口，汇聚 1,400+ REST 端点。</h1>
    <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-neutral-600">
      通过网关查看实时 Swagger 文档，为工具链拉取聚合规范，或直接从源码仓库审计各服务的原始契约。
    </p>
  </section>

  <section class="mt-14 grid gap-5 lg:grid-cols-3">
    {endpoints.map(([name, url, description]) => (
      <div class="brand-card px-6 py-6">
        <h2 class="text-xl font-semibold text-primary-900">{name}</h2>
        <p class="mt-3 text-sm leading-7 text-neutral-600">{description}</p>
        <pre class="developer-code mt-5">{url}</pre>
      </div>
    ))}
  </section>

  <section class="mt-16 brand-shell px-6 py-8 sm:px-10">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <span class="brand-kicker">推荐流程</span>
        <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-primary-900">先从网关开始探索，再逐个服务深入。</h2>
      </div>
      <div class="space-y-4 text-sm leading-7 text-neutral-600">
        <div class="rounded-2xl border border-primary-100 bg-white px-4 py-4">
          <strong class="text-primary-800">集成时：</strong>需要快速发现接口并导入客户端时，使用网关的聚合文档。
        </div>
        <div class="rounded-2xl border border-sky-100 bg-sky-50/80 px-4 py-4">
          <strong class="text-primary-800">调试时：</strong>需要精确路径、schema 或契约历史时，直接查看具体服务的规范。
        </div>
      </div>
    </div>
  </section>
</DevLayout>
